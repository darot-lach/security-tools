.env
dependency-check-data/
.trivy-cache/
.grype-cache/
output/
backups/
wordlists/

# zap-endpoints/automation.yaml and zap-auth/automation.yaml + scripts/ are
# tracked, reusable plans -- only their generated reports/logs are transient
# output. No trailing slash so this matches both the report files
# (report.html/json/md) and any report-asset directory ZAP creates alongside
# them -- including numbered variants from repeat runs, e.g.
# zap-endpoints-report2/ (ZAP suffixes a number rather than overwrite an
# existing asset dir of the same name).
zap-endpoints/zap-endpoints-report*
zap-auth/zap-report*
zap-auth/zap-authenticated-run.log

# Console output from `docker compose run ... | tee *.log` during ad-hoc scans
*-console.log
