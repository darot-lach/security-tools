# Copy this file to .env and fill in your own values. .env is gitignored.

# Free NVD API key -- request one at https://nvd.nist.gov/developers/request-an-api-key
# Without this, OWASP Dependency-Check cannot download vulnerability data at all
# (fails immediately with "Invalid API Key, length of 0").
NVD_API_KEY=

# Which local repo to scan (relative to this folder, or an absolute path) and the
# name used for output subfolders / Dependency-Check's --project label.
TARGET_REPO=../projects/backend-service
TARGET_NAME=backend-service

# Which live host to run DAST tools (ZAP/Nuclei/testssl) against.
TARGET_HOST=target-host.example.com

# Optional -- only used by the cdxgen service if you set FETCH_LICENSE=1 below.
# cdxgen will then query Maven Central/npm/NuGet for license metadata; without a
# token this can hit GitHub API rate limits partway through.
FETCH_LICENSE=
GITHUB_TOKEN=
